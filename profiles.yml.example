# Copy to ~/.dbt/profiles.yml
# thelook_ecommerce lives in the US multi-region, so the dataset dbt writes to must also be in US.
ltv_thelook:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: oauth            # run `gcloud auth application-default login` first
      project: your-gcp-project-id
      dataset: ltv             # models land in ltv_staging and ltv_marts
      location: US
      threads: 4
